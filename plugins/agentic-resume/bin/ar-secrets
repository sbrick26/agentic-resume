#!/bin/bash
# ar-secrets - grep-based secret scan using only standard tools. Usage: ar-secrets [DIR]
# Scans tracked and untracked (not ignored) files. Exit 1 on any hit.
# Prints file:line and the pattern name, never the matched value.
set -u
cd "${1:-${AR_PROJECT_ROOT:-.}}" || exit 2

patterns=(
  "anthropic_key:sk-ant-[A-Za-z0-9_-]{20,}"
  "openai_key:sk-[A-Za-z0-9]{32,}"
  "aws_access_key:AKIA[0-9A-Z]{16}"
  "aws_secret:aws_secret_access_key[[:space:]]*=[[:space:]]*[A-Za-z0-9/+]{30,}"
  "github_token:gh[pousr]_[A-Za-z0-9]{30,}"
  "github_pat:github_pat_[A-Za-z0-9_]{40,}"
  "slack_token:xox[abposr]-[A-Za-z0-9-]{10,}"
  "telegram_bot_token:[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}"
  "private_key:-----BEGIN [A-Z ]*PRIVATE KEY-----"
  "google_api_key:AIza[0-9A-Za-z_-]{35}"
  "jwt:eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\."
  "assigned_secret:(TOKEN|SECRET|PASSWORD|API_KEY)[A-Z_]*=[^[:space:]#]{8,}"
)

files=$(git ls-files --cached --others --exclude-standard 2>/dev/null)
[ -z "$files" ] && files=$(find . -type f -not -path './.git/*')

hits=0
for p in "${patterns[@]}"; do
  name="${p%%:*}"; rx="${p#*:}"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in */ar-secrets|ar-secrets) continue;; esac
    lines=$(grep -nEI -- "$rx" "$f" 2>/dev/null | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
    if [ -n "$lines" ]; then echo "HIT $name $f lines $lines"; hits=$((hits+1)); fi
  done <<< "$files"
done

# .env files must never be tracked
if git ls-files 2>/dev/null | grep -qE '(^|/)\.env($|\.)' ; then
  git ls-files | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' | while read -r f; do echo "HIT tracked_env $f"; done
fi

count=$(echo "$files" | grep -c .)
if [ "$hits" -eq 0 ]; then echo "secret-scan: clean ($count files, ${#patterns[@]} patterns)"; exit 0; fi
echo "secret-scan: $hits hit(s)"; exit 1
