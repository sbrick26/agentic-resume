#!/usr/bin/env python3
"""ar-doctor: is this machine and project ready for agentic-resume? Checks only; installs nothing.
Reports Python, a Chrome or Chromium for the one-page check, the claude CLI for mock AI screening,
git and gitleaks, the project layout, and the settings file. Exit 1 if a required piece is missing.
Usage: ar-doctor [--root DIR]"""
import argparse, json, os, shutil, subprocess, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import arlib

ap = argparse.ArgumentParser(); ap.add_argument("--root"); a = ap.parse_args()
root = arlib.project_root(a.root)
bad = 0


def line(ok, what, hint=""):
    global bad
    mark = "ok  " if ok is True else ("warn" if ok is None else "MISS")
    if ok is False: bad += 1
    print(f"[{mark}] {what}" + (f"  ({hint})" if hint and ok is not True else ""))


line(sys.version_info >= (3, 10), f"Python {sys.version.split()[0]} (3.10+ required)", "install Python 3.10 or newer")
here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
chrome = None
for c in [os.environ.get("AR_CHROME"), "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
          "/Applications/Chromium.app/Contents/MacOS/Chromium", "/opt/pw-browsers/chromium",
          shutil.which("google-chrome"), shutil.which("chromium"), shutil.which("chromium-browser"), shutil.which("microsoft-edge")]:
    if c and os.path.isfile(c) and os.access(c, os.X_OK): chrome = c; break
line(True if chrome else None, f"Chrome or Chromium for ar-fit: {chrome or 'not found'}", "install Chrome, or set AR_CHROME; ar-fit is skipped without it")
claude = shutil.which("claude")
line(True if claude else None, f"claude CLI for mock AI screening: {claude or 'not found'}", "needed only for the ai-screen skill")
line(bool(shutil.which("git")), "git", "install git")
line(True if shutil.which("gitleaks") else None, "gitleaks (optional second secret scan)", "optional: brew install gitleaks")
for d, need in (("stories", True), ("career-log/inbox", True), ("profile", True), ("writing-style", False), ("privacy", True), ("resume", True)):
    ok = os.path.isdir(os.path.join(root, d))
    line(ok if need else (True if ok else None), f"project folder {d}/", "run setup.sh or create it; see the README project layout")
priv = [p for p in ("privacy/client-names.txt", "privacy/blocklist.txt") if os.path.exists(os.path.join(root, p))]
line(True if priv else None, "private name lists in privacy/", "add client-names.txt so the leak guard knows what to block")
try:
    cfg = arlib.config(root); line(True, "settings " + json.dumps(cfg))
except Exception as e:
    line(False, f"agentic-resume.json: {e}", "fix the JSON")
if os.path.isdir(os.path.join(root, ".git")):
    r = subprocess.run(["git", "-C", root, "check-ignore", "-q", ".env"], capture_output=True)
    line(r.returncode == 0 or not os.path.exists(os.path.join(root, ".env")), ".env is git-ignored", "add .env to .gitignore")
print("ar-doctor: " + ("ready" if not bad else f"{bad} required item(s) missing"))
sys.exit(1 if bad else 0)
