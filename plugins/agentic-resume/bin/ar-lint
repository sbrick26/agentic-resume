#!/usr/bin/env python3
"""ar-lint: writing checks for text a reader will see.
Fails on: em or en dashes; words from the "Words to avoid" list in writing-style/STYLE.md (and the
casual-only words, in professional mode); resume bullets over max_bullet_words (default 25) or not starting with a verb;
sentences over 30 words. Usage: ar-lint [--root DIR] [--mode professional|casual] FILE..."""
import argparse, os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import arlib
NOT_VERBS = {"i", "my", "we", "our", "the", "a", "an", "this", "that", "responsible", "worked", "was", "were", "is", "am", "helped", "assisted"}
ap = argparse.ArgumentParser(); ap.add_argument("--root"); ap.add_argument("--mode", default="professional"); ap.add_argument("files", nargs="+")
a = ap.parse_args(); root = arlib.project_root(a.root)
MAXW = int(arlib.config(root)["max_bullet_words"])
banned, casual = arlib.banned_words(root)
casual = [w for w in casual if len(w.split()) == 1]
words = banned + (casual if a.mode == "professional" else [])
fails = []
for f in a.files:
    text = open(f, encoding="utf-8").read()
    body = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    for i, line in enumerate(body.splitlines(), 1):
        if arlib.EN_DASH in line or arlib.EM_DASH in line: fails.append(f"{f}:{i}: em or en dash")
        for w in words:
            if arlib.term_hits(line, w): fails.append(f"{f}:{i}: avoid '{w}'")
        s = line.strip()
        if s.startswith(("- ", "* ")) and not s.startswith("- [") :
            b = s[2:].strip(); n = len(b.split())
            if n > MAXW: fails.append(f"{f}:{i}: bullet has {n} words (max {MAXW}, set max_bullet_words in agentic-resume.json)")
            first = re.sub(r"[^a-z]", "", (b.split() or [""])[0].lower())
            if first in NOT_VERBS: fails.append(f"{f}:{i}: bullet should start with a verb, not '{first}'")
        elif s and not s.startswith(("#", "|")):
            for sent in re.split(r"(?<=[.!?])\s+", s):
                if len(sent.split()) > 30: fails.append(f"{f}:{i}: sentence has {len(sent.split())} words (max 30)")
    if a.mode == "professional" and body.strip() and body == body.lower() and re.search(r"[a-z]", body):
        fails.append(f"{f}: all lowercase text in professional mode")
for x in fails: print("FAIL", x)
print(f"ar-lint: {'clean' if not fails else str(len(fails)) + ' problem(s)'} ({len(a.files)} file(s), mode {a.mode})")
sys.exit(1 if fails else 0)
