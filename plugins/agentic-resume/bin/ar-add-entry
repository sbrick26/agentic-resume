#!/usr/bin/env python3
"""ar-add-entry: write one dated update into career-log/inbox/.
Usage: ar-add-entry --source cli --kind win "text"   (or text on stdin)
Every intake source (chat, Slack, email, CLI) calls this; nothing else writes the inbox."""
import argparse, datetime, os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import arlib
SOURCES = {"chat", "duet", "slack", "email", "cli", "notion", "other"}
KINDS = {"checkin", "win", "note", "correction"}
ap = argparse.ArgumentParser()
ap.add_argument("--source", required=True); ap.add_argument("--kind", required=True)
ap.add_argument("--refs", default=""); ap.add_argument("--corrects", default="")
ap.add_argument("--root"); ap.add_argument("--when", help="YYYY-MM-DDTHH:MM (default now)")
ap.add_argument("text", nargs="?")
a = ap.parse_args()
if a.source not in SOURCES: sys.exit(f"ar-add-entry: source must be one of {sorted(SOURCES)}")
if a.kind not in KINDS: sys.exit(f"ar-add-entry: kind must be one of {sorted(KINDS)}")
if a.kind == "correction" and not a.corrects: sys.exit("ar-add-entry: a correction must name the entry it corrects (--corrects)")
text = (a.text if a.text is not None else sys.stdin.read()).strip()
if not text: sys.exit("ar-add-entry: empty entry")
when = datetime.datetime.strptime(a.when, "%Y-%m-%dT%H:%M") if a.when else datetime.datetime.now()
root = arlib.project_root(a.root); inbox = os.path.join(root, "career-log", "inbox"); os.makedirs(inbox, exist_ok=True)
slug = "-".join(re.sub(r"[^a-z0-9 ]", "", text.lower()).split()[:5]) or "entry"
base = f"{when:%Y-%m-%dT%H%M}-{a.source}-{slug}"; path = os.path.join(inbox, base + ".md"); n = 2
while os.path.exists(path):
    path = os.path.join(inbox, f"{base}-{n}.md"); n += 1
refs = [r.strip() for r in a.refs.split(",") if r.strip()]
fm = ["---", f"date: {when:%Y-%m-%dT%H:%M}", f"source: {a.source}", f"kind: {a.kind}", "author: owner",
      "refs: [" + ", ".join(f'"{r}"' for r in refs) + "]"] + ([f"corrects: {a.corrects}"] if a.corrects else []) + ["---", text, ""]
open(path, "w", encoding="utf-8").write("\n".join(fm))
print(os.path.relpath(path, root))
