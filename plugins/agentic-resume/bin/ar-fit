#!/usr/bin/env python3
"""ar-fit: does the resume fit on one printed page, and which lines cost space?
Renders resume/resume.md as a plain single-column letter page in headless Chrome at a size ladder
(10.5pt and 0.5in margins, then 10pt and 0.5in, then 10pt and 0.45in) and reports the first size that
fits. If none fits it says how many lines are over and lists the cheapest fixes: bullets that wrap,
and lines whose last row holds only a few words (an orphan: trimming 2 to 4 words saves a whole line).
Usage: ar-fit [--root DIR] [--resume FILE] [--pdf OUT.pdf] [--json]
Exit 0 when it fits at some size, 1 when it does not, 0 with "skipped" when no Chrome is found.
Set AR_CHROME to the browser binary if it is not found automatically."""
import argparse, html, json, os, re, shutil, subprocess, sys, tempfile
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import arlib

LADDER = [(10.5, 0.5), (10.0, 0.5), (10.0, 0.45)]
ORPHAN = 0.35  # a last row under 35 percent full is an orphan


def find_chrome():
    for c in [os.environ.get("AR_CHROME"), "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
              "/Applications/Chromium.app/Contents/MacOS/Chromium", "/opt/pw-browsers/chromium",
              shutil.which("google-chrome"), shutil.which("chromium"), shutil.which("chromium-browser")]:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def inline(s):
    s = html.escape(s.replace("\\~", "~"))
    return re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", s)


def to_html(md, size, margin, measure):
    out, depth = [], 0
    for line in md.splitlines():
        if not line.strip():
            continue
        m = re.match(r"( *)[-*] (.*)", line)
        if m:
            lvl = len(m.group(1)) // 2 if len(m.group(1)) < 4 else len(m.group(1)) // 4 + (len(m.group(1)) % 4 > 0)
            out.append(f'<li class="l{min(lvl, 2)}" data-src="{html.escape(m.group(2)[:70])}">{inline(m.group(2))}</li>')
            continue
        h = re.match(r"(#+)\s*(.*)", line)
        if h:
            n = len(h.group(1)); cls = "name" if n == 1 else f"h{n}"
            out.append(f'<div class="{cls}">{inline(h.group(2))}</div>')
        else:
            out.append(f'<p data-src="{html.escape(line[:70])}">{inline(line)}</p>')
    css = f"""@page{{size:letter;margin:{margin}in}}
body{{font:{size}pt/1.22 Calibri,Carlito,Arial,sans-serif;margin:0;color:#111;{'width:' + str(8.5 - 2 * margin) + 'in' if measure else ''}}}
.name{{font-size:18pt;font-weight:700}}.h2{{font-size:12pt;font-weight:700;margin:5pt 0 2pt;border-bottom:1px solid #000}}
.h3{{font-size:11pt;font-weight:700;margin:5pt 0 1pt}}p{{margin:1pt 0}}ul{{margin:0;padding:0}}
li{{margin:0 0 0 14pt;list-style:disc}}li.l1{{margin-left:28pt;list-style:circle}}li.l2{{margin-left:42pt;list-style:square}}"""
    script = ""
    if measure:
        script = """<pre id="ar-out"></pre><script>
const res = {height: document.body.scrollHeight - document.getElementById('ar-out').offsetHeight, items: []};
for (const el of document.querySelectorAll('li,p[data-src]')) {
  const r = document.createRange(); r.selectNodeContents(el);
  const rows = {}; for (const b of r.getClientRects()) { if (b.width < 1) continue; const k = Math.round(b.top);
    rows[k] = Math.max(rows[k] || 0, b.right); }
  const tops = Object.keys(rows).map(Number).sort((a, b) => a - b);
  const left = el.getBoundingClientRect().left, width = el.getBoundingClientRect().width;
  const last = tops.length ? (rows[tops[tops.length - 1]] - left) / width : 1;
  res.items.push({src: el.dataset.src, rows: tops.length, last_fill: Math.round(last * 100) / 100});
}
document.getElementById('ar-out').textContent = 'AR_FIT:' + JSON.stringify(res);
</script>"""
    return f'<html><head><meta charset="utf-8"><title>Resume</title><style>{css}</style></head><body><ul>{"".join(out)}</ul>{script}</body></html>'


def measure(chrome, md, size, margin, tmp):
    p = os.path.join(tmp, "m.html"); open(p, "w", encoding="utf-8").write(to_html(md, size, margin, True))
    r = subprocess.run([chrome, "--headless", "--disable-gpu", "--no-sandbox", "--dump-dom", "file://" + p],
                       capture_output=True, text=True, timeout=120)
    m = re.search(r"AR_FIT:(\{.*?\})</pre>", html.unescape(r.stdout), re.S) or re.search(r"AR_FIT:(\{.*\})", html.unescape(r.stdout))
    if not m:
        raise RuntimeError("could not read the measurement from Chrome")
    d = json.loads(m.group(1)); d["page"] = round((11 - 2 * margin) * 96); d["line"] = size * 1.22 * 96 / 72
    return d


def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--root"); ap.add_argument("--resume")
    ap.add_argument("--pdf"); ap.add_argument("--json", action="store_true"); a = ap.parse_args()
    root = arlib.project_root(a.root)
    path = a.resume or os.path.join(root, "resume", "resume.md")
    md = open(path, encoding="utf-8").read()
    chrome = find_chrome()
    if not chrome:
        print("ar-fit: skipped (no Chrome or Chromium found; set AR_CHROME)"); return 0
    tmp = tempfile.mkdtemp(prefix="ar-fit-")
    results = []
    for size, margin in LADDER:
        d = measure(chrome, md, size, margin, tmp)
        over = (d["height"] - d["page"]) / d["line"]
        results.append(dict(size=size, margin=margin, fits=d["height"] <= d["page"], lines_over=round(over, 1), items=d["items"]))
        if d["height"] <= d["page"]:
            break
    best = results[-1]
    if a.pdf:
        hp = os.path.join(tmp, "p.html"); open(hp, "w", encoding="utf-8").write(to_html(md, best["size"], best["margin"], False))
        subprocess.run([chrome, "--headless", "--disable-gpu", "--no-sandbox", "--no-pdf-header-footer",
                        f"--print-to-pdf={os.path.abspath(a.pdf)}", "file://" + hp], capture_output=True, timeout=120)
    wraps = sorted([i for i in best["items"] if i["rows"] > 1], key=lambda i: i["last_fill"])
    orphans = [i for i in wraps if i["last_fill"] < ORPHAN]
    if a.json:
        print(json.dumps(dict(fits=best["fits"], size=best["size"], margin=best["margin"], lines_over=best["lines_over"],
                              ladder=[{k: r[k] for k in ("size", "margin", "fits", "lines_over")} for r in results],
                              orphans=orphans, wrapping=wraps), indent=1))
    else:
        for r in results:
            state = "fits" if r["fits"] else f"{r['lines_over']} lines over"
            print(f"ar-fit: {r['size']}pt, {r['margin']}in margins: {state}")
        if best["fits"] and best["size"] < 10.5:
            print("ar-fit: note: fits only below 10.5pt; several career centers set 10.5pt as the floor. Fine if the owner accepts it.")
        if not best["fits"]:
            print(f"ar-fit: does not fit one page even at {best['size']}pt; cut about {max(1, round(best['lines_over'] + 0.5))} lines.")
        if orphans:
            print("orphan lines (trim 2 to 4 words to save a whole line each):")
            for i in orphans: print(f"  - last row {int(i['last_fill'] * 100)}% full: {i['src']}...")
        long = [i for i in wraps if i["rows"] >= 3]
        if long:
            print("lines of 3+ rows (split the idea or cut the list in parentheses):")
            for i in long: print(f"  - {i['rows']} rows: {i['src']}...")
        if a.pdf: print(f"ar-fit: PDF at {best['size']}pt written to {a.pdf}")
    shutil.rmtree(tmp, ignore_errors=True)
    return 0 if best["fits"] else 1


if __name__ == "__main__":
    sys.exit(main())
