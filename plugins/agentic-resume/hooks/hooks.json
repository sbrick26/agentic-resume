{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ar-hook-precommit\"" },
          { "type": "command", "if": "Bash(git push *)", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ar-hook-precommit\"" }
        ]
      }
    ]
  }
}
